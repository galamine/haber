# Base URL of the tRPC backend (apps/server)
VITE_SERVER_URL=http://localhost:3000

# Base URL of the separate game app that hosts the therapy/activity game
# HTML bundles (activity_games/, therapy_games/, trail_games/). "Open Game"
# on a session launches ${VITE_GAME_SERVER_URL}${gameVersion.path}.
VITE_GAME_SERVER_URL=http://localhost:8080
