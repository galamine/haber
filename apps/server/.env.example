CORS_ORIGIN=http://localhost:3001,http://localhost:8080
FRONTEND_URL=http://localhost:3001

DATABASE_URL=postgresql://postgres:password@localhost:5432/haber-final

# Must be at least 32 characters
JWT_SECRET=changeme-this-must-be-at-least-32-characters-long

# Get your key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Email for the initial SuperAdmin account (used by the seed:superadmin script)
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# Cloudinary URL
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@cloud_name

# DPDP compliance — must be 'india' for data residency
DATA_REGION=india

# Minutes an IN_PROGRESS session can run before it's auto-marked TIMED_OUT
SESSION_TIMEOUT_MINUTES=120
