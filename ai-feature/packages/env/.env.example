# Sarvam AI Speech-to-Text Configuration
SARVAM_SUBSCRIPTION_KEY=your-sarvam-subscription-key-here
SARVAM_API_URL=https://api.sarvam.ai

# LLM Provider Configuration
# Options: gemini (default), openai, anthropic, azure
# Note: Only gemini is currently implemented. To switch, implement the provider in lib/providers/
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Future providers (not implemented yet - only needed when switching)
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
