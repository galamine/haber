enum ConversationStatus {
  active
  paused
  completed
}

enum DraftStatus {
  active
  superseded
}

enum Confidence {
  high
  medium
  low
}

model AssessmentCapture {
  id                String             @id @default(cuid())
  childId           String
  assessmentId      String?
  assessmentType    String
  status            ConversationStatus @default(active)
  transcriptHistory String?
  startedAt         DateTime           @default(now())
  endedAt           DateTime?

  draftValues CaptureDraftValue[]
  overrides   CaptureOverride[]

  @@index([childId, assessmentType, status])
  @@map("assessment_capture")
}

model CaptureDraftValue {
  id         String     @id @default(cuid())
  captureId  String
  fieldId    String
  value      Json
  confidence Confidence
  sourceText String?
  status     DraftStatus @default(active)
  createdAt  DateTime   @default(now())

  capture AssessmentCapture @relation(fields: [captureId], references: [id])

  @@index([captureId, fieldId])
  @@map("capture_draft_value")
}

model CaptureOverride {
  id            String   @id @default(cuid())
  captureId     String
  fieldId       String
  aiValue       Json
  overrideValue Json
  overrideAt    DateTime @default(now())

  capture AssessmentCapture @relation(fields: [captureId], references: [id])

  @@index([captureId, fieldId])
  @@map("capture_field_override")
}
